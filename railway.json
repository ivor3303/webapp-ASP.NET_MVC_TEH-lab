{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Vjezba.App/Dockerfile",
    "buildContext": "."
  },
  "deploy": {
    "startCommand": "dotnet Vjezba.App.dll",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
