@page
@model LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-page">
    <div class="auth-card">
        <h2 class="auth-title">Prijava</h2>
        <p class="auth-subtitle">Prijavite se na TEH Safety Maintenance Portal</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="auth-input" autocomplete="username" placeholder="vas@email.hr" />
                <span asp-validation-for="Input.Email" class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">Lozinka</label>
                <input asp-for="Input.Password" class="auth-input" type="password" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="auth-validation"></span>
            </div>

            <div class="auth-remember">
                <label class="auth-checkbox">
                    <input asp-for="Input.RememberMe" type="checkbox" />
                    <span>Zapamti me</span>
                </label>
            </div>

            <button type="submit" class="auth-submit">Prijavi se</button>
        </form>

        <div class="auth-divider"><span>ili</span></div>

        <form method="post" asp-page-handler="ExternalLogin">
            <button type="submit" name="provider" value="Google" class="auth-google-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Prijava s Google računom
            </button>
        </form>

        <div class="auth-footer">
            <a asp-page="./Register">Nemate račun? Registrirajte se</a>
        </div>
    </div>
</div>

<style>
.auth-page {
    display: flex;
    justify-content: center;
    padding: 40px 16px;
}

.auth-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 36px;
    width: 100%;
    max-width: 420px;
}

.auth-title {
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    margin: 0 0 6px;
}

.auth-subtitle {
    font-size: 13px;
    color: rgba(255,255,255,0.45);
    margin: 0 0 28px;
}

.auth-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
}

.auth-field label {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.03em;
    text-transform: uppercase;
}

.auth-input {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 10px 14px;
    color: #fff;
    font-size: 14px;
    transition: border-color 0.15s;
    outline: none;
    width: 100%;
    box-sizing: border-box;
}

.auth-input:focus {
    border-color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.08);
}

.auth-input::placeholder {
    color: rgba(255,255,255,0.2);
}

.auth-validation {
    font-size: 12px;
    color: #ff8080;
}

.auth-error {
    background: rgba(255,80,80,0.1);
    border: 1px solid rgba(255,80,80,0.2);
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 13px;
    color: #ff8080;
    margin-bottom: 16px;
}

.auth-error:empty {
    display: none;
}

.auth-remember {
    margin-bottom: 20px;
}

.auth-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
}

.auth-checkbox input {
    accent-color: #7eb8f7;
}

.auth-submit {
    width: 100%;
    padding: 11px;
    background: rgba(126,184,247,0.15);
    border: 1px solid rgba(126,184,247,0.3);
    border-radius: 6px;
    color: #7eb8f7;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
}

.auth-submit:hover {
    background: rgba(126,184,247,0.25);
    border-color: rgba(126,184,247,0.5);
}

.auth-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
    color: rgba(255,255,255,0.2);
    font-size: 12px;
}

.auth-divider::before,
.auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.08);
}

.auth-google-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    color: rgba(255,255,255,0.75);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
}

.auth-google-btn:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
}

.auth-footer {
    text-align: center;
    margin-top: 20px;
    font-size: 13px;
}

.auth-footer a {
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: color 0.15s;
}

.auth-footer a:hover {
    color: rgba(255,255,255,0.7);
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
