@page
@model LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<section class="detail-panel form-panel">
    <h1>Prijava</h1>
    <p class="header-subtitle">Prijavite se sa svojim računom za pristup aplikaciji.</p>

    <form id="account" method="post" class="entity-form" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label class="form-label" asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true" placeholder="ime@primjer.hr" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" asp-for="Input.Password">Lozinka</label>
            <input asp-for="Input.Password" class="form-input" autocomplete="current-password" aria-required="true" placeholder="Lozinka" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <div class="form-field login-remember-field">
            <label class="login-remember-label">
                <input class="login-remember-checkbox" asp-for="Input.RememberMe" />
                Zapamti me
            </label>
        </div>

        <div class="form-actions">
            <button id="login-submit" type="submit" class="action-button action-button-primary">Prijava</button>
        </div>

        <p class="login-register-link">
            Nemate račun? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrirajte se</a>
        </p>
    </form>

    @{
        if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="login-divider"><span>ili</span></div>

            <form id="external-account" asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="action-button action-button-secondary login-google-button" name="provider" value="@provider.Name" title="Prijava s @provider.DisplayName računom">
                        Prijava s @provider.DisplayName računom
                    </button>
                }
            </form>
        }
    }
</section>

<style>
    .login-remember-field {
        gap: 0;
    }

    .login-remember-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        font-size: 0.9rem;
        cursor: pointer;
    }

    .login-remember-checkbox {
        width: 1.05rem;
        height: 1.05rem;
        accent-color: var(--accent);
        cursor: pointer;
    }

    .login-register-link {
        margin: 0.4rem 0 0;
        font-size: 0.88rem;
        color: #9fb3c8;
    }

    .login-register-link a {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
    }

    .login-register-link a:hover {
        text-decoration: underline;
    }

    .login-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.4rem 0 1.1rem;
        color: #6c8299;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .login-divider::before,
    .login-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #2d4057;
    }

    .login-google-button {
        width: 100%;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
