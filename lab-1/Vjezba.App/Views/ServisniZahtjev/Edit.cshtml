@model ServisniZahtjev

@{
    ViewData["Title"] = "Uredi servisni zahtjev";
}

<section class="detail-panel form-panel">
    <h1>Uredi servisni zahtjev</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="entity-form" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <input asp-for="Id" type="hidden" />

        <div class="form-field">
            <partial name="_DatePicker" model='new {
                FieldName = "DatumPrijave",
                Label = "Datum prijave",
                Value = Model.DatumPrijave,
                Placeholder = "Odaberite datum..."
            }' />
        </div>

        <div class="form-field">
            <label class="form-label" for="OpisKvara">Opis kvara</label>
            <input asp-for="OpisKvara" class="form-input" autocomplete="off" />
            <span asp-validation-for="OpisKvara" class="field-error"></span>
        </div>

        <div class="form-field urgency-selector-field">
            <span class="form-label">Hitno</span>
            <input asp-for="Hitno" type="hidden" id="Hitno" />
            <div class="urgency-selector" data-boolean-selector data-target="#Hitno" data-default="@(Model.Hitno ? "true" : "false")">
                <button type="button" class="urgency-selector-button urgency-selector-button-true" data-value="true">Hitno</button>
                <button type="button" class="urgency-selector-button urgency-selector-button-false" data-value="false">Nije hitno</button>
            </div>
            <span asp-validation-for="Hitno" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="Komentar">Komentar</label>
            <input asp-for="Komentar" class="form-input" autocomplete="off" />
            <span asp-validation-for="Komentar" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="OpremaId-autocomplete-text">Oprema</label>
            <partial name="_AutocompleteDropdown" model='new {
                FieldName = "OpremaId",
                Placeholder = "Pretražite opremu...",
                SearchUrl = "/oprema/autocomplete",
                SelectedId = Model.OpremaId,
                SelectedText = Model.Oprema?.Naziv,
                ValidationTargetId = "OpremaId-error",
                ValidationMessage = "Molimo odaberite opremu"
            }' />
            <span asp-validation-for="OpremaId" id="OpremaId-error" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="action-button action-button-primary">Spremi promjene</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-boolean-selector]').forEach((selector) => {
                const targetSelector = selector.getAttribute('data-target');
                const hiddenInput = targetSelector ? document.querySelector(targetSelector) : null;
                const buttons = Array.from(selector.querySelectorAll('[data-value]'));

                if (!hiddenInput || buttons.length === 0) {
                    return;
                }

                const syncState = (value) => {
                    hiddenInput.value = value ? 'true' : 'false';
                    buttons.forEach((button) => {
                        const isActive = button.getAttribute('data-value') === String(value);
                        button.classList.toggle('is-active', isActive);
                        button.setAttribute('aria-pressed', String(isActive));
                    });
                };

                buttons.forEach((button) => {
                    button.addEventListener('click', () => {
                        syncState(button.getAttribute('data-value') === 'true');
                    });
                });

                syncState(hiddenInput.value === 'true' || selector.getAttribute('data-default') === 'true');
            });
        });
    </script>
}