@model Odrzavanje

@{
    ViewData["Title"] = "Uredi održavanje";
}

<section class="detail-panel form-panel">
    <h1>Uredi održavanje</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="entity-form" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <input asp-for="Id" type="hidden" />

        <div class="form-field">
            <partial name="_DatePicker" model='new {
                FieldName = "Datum",
                Label = "Datum",
                Value = Model.Datum,
                Placeholder = "Odaberite datum..."
            }' />
        </div>

        <div class="form-field">
            <label class="form-label" for="Opis">Opis</label>
            <textarea asp-for="Opis" class="form-input" rows="3" id="opisTextarea" autocomplete="off"></textarea>
            <button type="button" class="action-button action-button-secondary btn-sm" onclick="generateAiOpis(this)">✨ Generiraj opis s AI</button>
            <span asp-validation-for="Opis" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="Cijena">Cijena</label>
            <input asp-for="Cijena" class="form-input" autocomplete="off" />
            <span asp-validation-for="Cijena" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="Napomena">Napomena</label>
            <input asp-for="Napomena" class="form-input" autocomplete="off" />
            <span asp-validation-for="Napomena" class="field-error"></span>
        </div>

        <input asp-for="TrajanjeTicks" type="hidden" id="TrajanjeTicks" />

        <div class="form-field">
            <label class="form-label">Trajanje</label>
            <div class="time-split-grid" data-duration-picker data-existing-ticks="@Model.TrajanjeTicks">
                <div>
                    <label class="form-label" for="TrajanjeSati">Sati</label>
                    <input type="number" id="TrajanjeSati" class="form-input" min="0" max="23" step="1" value="0" />
                </div>
                <div>
                    <label class="form-label" for="TrajanjeMinute">Minute</label>
                    <input type="number" id="TrajanjeMinute" class="form-input" min="0" max="59" step="1" value="0" />
                </div>
            </div>
            <span asp-validation-for="TrajanjeTicks" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="OpremaId-autocomplete-text">Oprema</label>
            <partial name="_AutocompleteDropdown" model='new {
                FieldName = "OpremaId",
                Placeholder = "Pretražite opremu...",
                SearchUrl = "/oprema/autocomplete",
                SelectedId = Model.OpremaId,
                InitialText = ViewBag.OpremaText as string ?? string.Empty,
                SelectedText = ViewBag.OpremaText as string ?? string.Empty,
                ValidationTargetId = "OpremaId-error",
                ValidationMessage = "Molimo odaberite opremu"
            }' />
            <span asp-validation-for="OpremaId" id="OpremaId-error" class="field-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="IzvrsioId-autocomplete-text">Izvršio</label>
            <partial name="_AutocompleteDropdown" model='new {
                FieldName = "IzvrsioId",
                Placeholder = "Pretražite radnike...",
                SearchUrl = "/radnici/autocomplete",
                SelectedId = Model.IzvrsioId,
                InitialText = ViewBag.IzvrsioText as string ?? string.Empty,
                SelectedText = ViewBag.IzvrsioText as string ?? string.Empty,
                ValidationTargetId = "IzvrsioId-error",
                ValidationMessage = "Molimo odaberite radnika"
            }' />
            <span asp-validation-for="IzvrsioId" id="IzvrsioId-error" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="action-button action-button-primary">Spremi promjene</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const cijenaInput = document.querySelector('[name="Cijena"]');
            const durationPicker = document.querySelector('[data-duration-picker]');
            const trajanjeTicksInput = document.getElementById('TrajanjeTicks');
            const satiInput = document.getElementById('TrajanjeSati');
            const minuteInput = document.getElementById('TrajanjeMinute');

            const updateTicks = () => {
                if (!trajanjeTicksInput || !satiInput || !minuteInput) {
                    return;
                }

                const sati = Math.max(0, Math.min(23, Number.parseInt(satiInput.value || '0', 10) || 0));
                const minute = Math.max(0, Math.min(59, Number.parseInt(minuteInput.value || '0', 10) || 0));
                const ticks = ((sati * 3600) + (minute * 60)) * 10000000;

                satiInput.value = String(sati);
                minuteInput.value = String(minute);
                trajanjeTicksInput.value = String(ticks);
            };

            if (durationPicker && trajanjeTicksInput && satiInput && minuteInput) {
                const existingTicks = Number.parseInt(durationPicker.dataset.existingTicks || '0', 10) || 0;
                const totalSeconds = Math.floor(existingTicks / 10000000);
                const sati = Math.floor(totalSeconds / 3600);
                const minute = Math.floor((totalSeconds % 3600) / 60);

                satiInput.value = String(Math.max(0, Math.min(23, sati)));
                minuteInput.value = String(Math.max(0, Math.min(59, minute)));
                updateTicks();

                satiInput.addEventListener('input', updateTicks);
                minuteInput.addEventListener('input', updateTicks);
                satiInput.addEventListener('blur', updateTicks);
                minuteInput.addEventListener('blur', updateTicks);

                const form = durationPicker.closest('form');
                if (form) {
                    form.addEventListener('submit', updateTicks);
                }
            }

            if (!cijenaInput) {
                return;
            }

            cijenaInput.addEventListener('blur', function () {
                this.value = this.value.trim();
            });
        });
    </script>
    <script>
        async function generateAiOpis(btn) {
            const opremaText = document.getElementById('OpremaId-autocomplete-text');
            const opremaNaziv = opremaText && opremaText.value.trim() ? opremaText.value.trim() : 'oprema';

            btn.disabled = true;
            btn.textContent = 'Generiranje...';

            try {
                const response = await fetch('/api/ai/generate-maintenance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ opremaNaziv: opremaNaziv })
                });
                const data = await response.json();
                document.getElementById('opisTextarea').value = data.text;
            } catch (e) {
                alert('Greška pri generiranju opisa.');
            } finally {
                btn.disabled = false;
                btn.textContent = '✨ Generiraj opis s AI';
            }
        }
    </script>
}