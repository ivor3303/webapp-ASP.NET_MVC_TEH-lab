@using Microsoft.AspNetCore.Identity
@using Vjezba.Model
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div class="login-links">
    @if (SignInManager.IsSignedIn(User))
    {
        <span class="login-user">@UserManager.GetUserName(User)</span>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="d-inline">
            <button type="submit" class="btn btn-link p-0 align-baseline">Logout</button>
        </form>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            <a asp-area="Identity" asp-page="/Account/Register">Register</a>
            <a asp-area="Identity" asp-page="/Account/Login">Login</a>
            <form asp-area="Identity" asp-page="/Account/Login" asp-page-handler="ExternalLogin" method="post">
                <button type="submit" name="provider" value="Google" class="btn btn-danger">
                    Prijava s Google računom
                </button>
            </form>
        </div>
    }
</div>