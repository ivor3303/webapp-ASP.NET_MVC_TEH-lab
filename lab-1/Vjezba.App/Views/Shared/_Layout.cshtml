<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TEH Safety Maintenance Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "Home";
    var currentAction = (string?)ViewContext.RouteData.Values["action"] ?? "Index";

    string LabelFor(string value)
    {
        return value switch
        {
            "Home" => "Home",
            "RadnaOprema" => "Radna oprema",
            "Proizvodac" => "Proizvođači",
            "KategorijaOpreme" => "Kategorije",
            "Lokacija" => "Lokacije",
            "Odrzavanje" => "Održavanja",
            "Izvjestaj" => "Izvjestaji",
            "Radnik" => "Radnici",
            "ServisniZahtjev" => "Servisni zahtjevi",
            "ZaduzenjeOpreme" => "Zaduženja opreme",
            "AiAsistent" => "AI Asistent",
            "Index" => "Pregled",
            "Details" => "Detalji",
            _ => value
        };
    }

    string ActiveClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        ? "nav-item active"
        : "nav-item";
}

    <div class="app-shell">
        <aside class="side-nav" id="sideNav">
            <div class="brand-block">
                <p class="brand-kicker">TEH LAB</p>
                <a class="brand" asp-controller="Home" asp-action="Index">Evidencija opreme</a>
            </div>

            <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="sideNavLinks">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>Izbornik</span>
            </button>

            <div class="side-nav-links" id="sideNavLinks">
                <div class="nav-group nav-group-overview">
                    <p class="nav-section-title">Pregled</p>
                    <nav class="nav-stack">
                        <a class="@ActiveClass("Home")" asp-controller="Home" asp-action="Index">Home</a>
                    </nav>
                </div>

                <div class="nav-divider"></div>

                <div class="nav-group nav-group-primary">
                    <p class="nav-section-title">Oprema i resursi</p>
                    <nav class="nav-stack">
                        <a class="@ActiveClass("RadnaOprema")" asp-controller="RadnaOprema" asp-action="Index">Radna oprema</a>
                        <a class="@ActiveClass("KategorijaOpreme")" asp-controller="KategorijaOpreme" asp-action="Index">Kategorije</a>
                        <a class="@ActiveClass("Proizvodac")" asp-controller="Proizvodac" asp-action="Index">Proizvođači</a>
                    </nav>
                </div>

                <div class="nav-group nav-group-secondary">
                    <p class="nav-section-title">Lokacije i timovi</p>
                    <nav class="nav-stack">
                        <a class="@ActiveClass("Lokacija")" asp-controller="Lokacija" asp-action="Index">Lokacije</a>
                        <a class="@ActiveClass("Radnik")" asp-controller="Radnik" asp-action="Index">Radnici</a>
                    </nav>
                </div>

                <div class="nav-group nav-group-tertiary">
                    <p class="nav-section-title">Održavanje i zahtjevi</p>
                    <nav class="nav-stack">
                        <a class="@ActiveClass("Odrzavanje")" asp-controller="Odrzavanje" asp-action="Index">Održavanja</a>
                        <a class="@ActiveClass("ServisniZahtjev")" asp-controller="ServisniZahtjev" asp-action="Index">Servisni zahtjevi</a>
                        <a class="@ActiveClass("ZaduzenjeOpreme")" asp-controller="ZaduzenjeOpreme" asp-action="Index">Zaduženja opreme</a>
                        <a class="@ActiveClass("AiAsistent")" asp-controller="AiAsistent" asp-action="Index">✨ AI Asistent</a>
                    </nav>
                </div>
            </div>
        </aside>

        <div class="content-area">
            <header class="top-header">
                <div class="header-heading">
                    <p class="page-kicker">Internal dashboard</p>
                    <h1 class="page-title">@LabelFor(currentController)</h1>
                    <p class="header-subtitle">Operativni pregled i pracenje statusa radne opreme</p>
                </div>
                <div class="header-actions">
                    <form class="navbar-search" asp-controller="GlobalSearch" asp-action="Index" method="get">
                        <input class="navbar-search-input" type="search" name="q" placeholder="Pretraži..." value="@Context.Request.Query["q"]" autocomplete="off" />
                        <button class="navbar-search-button" type="submit" aria-label="Pretraži">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="7"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                    </form>
                    <div class="status-pill">Live tracking</div>
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <nav class="breadcrumbs" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                @if (!string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="crumb-separator">/</span>
                    <a asp-controller="@currentController" asp-action="Index">@LabelFor(currentController)</a>
                }
                @if (!string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="crumb-separator">/</span>
                    <span class="crumb-current">@LabelFor(currentAction)</span>
                }
            </nav>

            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <p>TEH Safety Maintenance Portal</p>
                <p>Evidencija održavanja radne opreme u zaštiti na radu</p>
            </footer>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="toast toast-success is-visible" id="success-toast" role="status" aria-live="polite">
            <span class="toast-title">Uspjeh</span>
            <span class="toast-message">@successMessage</span>
        </div>
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (() => {
            const toast = document.getElementById('success-toast');
            if (!toast) {
                return;
            }

            window.setTimeout(() => {
                toast.classList.add('toast-hiding');
                window.setTimeout(() => toast.remove(), 220);
            }, 3000);
        })();
    </script>
    <script>
        (() => {
            const navToggle = document.getElementById('navToggle');
            const sideNav = document.getElementById('sideNav');
            if (!navToggle || !sideNav) {
                return;
            }

            navToggle.addEventListener('click', () => {
                const isOpen = sideNav.classList.toggle('is-open');
                navToggle.setAttribute('aria-expanded', String(isOpen));
            });

            sideNav.querySelectorAll('.side-nav-links a').forEach((link) => {
                link.addEventListener('click', () => {
                    sideNav.classList.remove('is-open');
                    navToggle.setAttribute('aria-expanded', 'false');
                });
            });
        })();
    </script>
</body>
</html>
