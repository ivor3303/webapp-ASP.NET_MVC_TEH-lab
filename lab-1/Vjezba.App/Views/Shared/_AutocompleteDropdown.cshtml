@model dynamic

@{
    object modelObject = Model;

    string GetString(string propertyName)
    {
        var value = modelObject.GetType().GetProperty(propertyName)?.GetValue(modelObject);
        return value?.ToString() ?? string.Empty;
    }

    int GetInt(string propertyName)
    {
        var value = modelObject.GetType().GetProperty(propertyName)?.GetValue(modelObject);
        return value is int integerValue ? integerValue : 0;
    }

    var fieldName = GetString("FieldName");
    var placeholder = GetString("Placeholder");
    var searchUrl = GetString("SearchUrl");
    var selectedId = GetInt("SelectedId");
    var selectedText = GetString("SelectedText");
    var validationTargetId = GetString("ValidationTargetId");
    var validationMessage = GetString("ValidationMessage");
    var initialText = GetString("InitialText");
    var rootId = $"{fieldName}-autocomplete-root";
    var textId = $"{fieldName}-autocomplete-text";
    var hiddenId = $"{fieldName}-autocomplete-id";
    var listId = $"{fieldName}-autocomplete-list";
}

<div class="autocomplete-widget" id="@rootId" data-search-url="@searchUrl" data-field-name="@fieldName" data-validation-target-id="@validationTargetId" data-validation-message="@validationMessage">
    <input type="text"
           class="autocomplete-input"
           id="@textId"
           value="@(string.IsNullOrWhiteSpace(initialText) ? selectedText : initialText)"
           placeholder="@placeholder"
            autocomplete="off"
           aria-autocomplete="list"
           aria-expanded="false"
           aria-controls="@listId" />

    <input type="hidden" name="@fieldName" id="@hiddenId" value="@selectedId" />

    <div class="autocomplete-dropdown" id="@listId" hidden></div>
</div>

<script>
    (function () {
        window.autocompleteDropdown = window.autocompleteDropdown || {
            init: function (root) {
                if (!root || root.dataset.autocompleteInitialized === 'true') {
                    return;
                }

                root.dataset.autocompleteInitialized = 'true';

                const searchUrl = root.dataset.searchUrl;
                const textInput = root.querySelector('.autocomplete-input');
                const hiddenInput = root.querySelector('input[type="hidden"]');
                const dropdown = root.querySelector('.autocomplete-dropdown');
                const validationTargetId = root.dataset.validationTargetId;
                const validationTarget = validationTargetId ? document.getElementById(validationTargetId) : null;
                const validationMessage = root.dataset.validationMessage || 'Molimo odaberite lokaciju';
                let debounceTimer = null;
                let activeIndex = -1;
                let results = [];
                let abortController = null;

                const setValidationState = (isValid) => {
                    textInput.classList.toggle('is-invalid', !isValid);
                    root.classList.toggle('is-invalid', !isValid);

                    if (validationTarget) {
                        validationTarget.textContent = isValid ? '' : validationMessage;
                    }
                };

                const closeDropdown = () => {
                    dropdown.hidden = true;
                    dropdown.innerHTML = '';
                    dropdown.dataset.open = 'false';
                    textInput.setAttribute('aria-expanded', 'false');
                    activeIndex = -1;
                    results = [];
                };

                const setActive = (index) => {
                    const items = dropdown.querySelectorAll('.autocomplete-option');
                    items.forEach((item, itemIndex) => {
                        item.classList.toggle('is-active', itemIndex === index);
                    });
                    activeIndex = index;
                };

                const selectItem = (item) => {
                    textInput.value = item.text;
                    hiddenInput.value = item.id;
                    setValidationState(true);
                    closeDropdown();
                };

                const renderResults = (items) => {
                    results = items;
                    dropdown.innerHTML = '';

                    if (!items.length) {
                        const empty = document.createElement('div');
                        empty.className = 'autocomplete-empty';
                        empty.textContent = 'Nema rezultata';
                        dropdown.appendChild(empty);
                        dropdown.hidden = false;
                        dropdown.dataset.open = 'true';
                        textInput.setAttribute('aria-expanded', 'true');
                        activeIndex = -1;
                        return;
                    }

                    const list = document.createElement('div');
                    list.className = 'autocomplete-options';

                    items.forEach((item, index) => {
                        const option = document.createElement('button');
                        option.type = 'button';
                        option.className = 'autocomplete-option';
                        option.setAttribute('role', 'option');
                        option.textContent = item.text;
                        option.addEventListener('click', () => selectItem(item));
                        option.addEventListener('mouseenter', () => setActive(index));
                        list.appendChild(option);
                    });

                    dropdown.appendChild(list);
                    dropdown.hidden = false;
                    dropdown.dataset.open = 'true';
                    textInput.setAttribute('aria-expanded', 'true');
                    setActive(0);
                };

                const search = async (query) => {
                    if (abortController) {
                        abortController.abort();
                    }

                    abortController = new AbortController();

                    try {
                        const response = await fetch(`${searchUrl}?query=${encodeURIComponent(query)}`, {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            signal: abortController.signal
                        });

                        if (!response.ok) {
                            closeDropdown();
                            return;
                        }

                        const data = await response.json();
                        renderResults(Array.isArray(data) ? data : []);
                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            closeDropdown();
                        }
                    }
                };

                textInput.addEventListener('input', () => {
                    hiddenInput.value = '0';
                    window.clearTimeout(debounceTimer);

                    const query = textInput.value.trim();
                    if (!query) {
                        closeDropdown();
                        return;
                    }

                    debounceTimer = window.setTimeout(() => search(query), 300);
                });

                textInput.addEventListener('keydown', (event) => {
                    if (dropdown.hidden || !results.length) {
                        if (event.key === 'Escape') {
                            closeDropdown();
                        }
                        return;
                    }

                    if (event.key === 'ArrowDown') {
                        event.preventDefault();
                        setActive(Math.min(activeIndex + 1, results.length - 1));
                    } else if (event.key === 'ArrowUp') {
                        event.preventDefault();
                        setActive(Math.max(activeIndex - 1, 0));
                    } else if (event.key === 'Enter') {
                        event.preventDefault();
                        const item = results[activeIndex];
                        if (item) {
                            selectItem(item);
                        }
                    } else if (event.key === 'Escape') {
                        closeDropdown();
                    }
                });

                textInput.addEventListener('focus', () => {
                    if (textInput.value.trim() && !dropdown.hidden) {
                        dropdown.hidden = false;
                    }
                });

                const form = root.closest('form');
                if (form) {
                    form.addEventListener('submit', () => {
                        setValidationState(!!hiddenInput.value && Number(hiddenInput.value) > 0);
                    });
                }

                document.addEventListener('click', (event) => {
                    if (!root.contains(event.target)) {
                        closeDropdown();
                    }
                });
            }
        };

        window.autocompleteDropdown.init(document.getElementById('@rootId'));
    })();
</script>